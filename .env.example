# Environment Variables for Local Development
# Copy this file to .env and fill in your actual values

# Database Configuration
# Use PostgreSQL connection URL format
DATABASE_URL=postgresql://postgres:online@localhost:5432/CoffeeShopDB

# Stripe API Keys (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# SMTP Settings (use Mailtrap for development: https://mailtrap.io)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=orders@007coffee.shop

# JWT Settings
JWT_KEY=b4e13cfd9fae2c3a8f5d87c9b1d2e3f4b4e13cfd9fae2c3a8f5d87c9b1d2e3f4
JWT_ISSUER=007coffee.shop
JWT_AUDIENCE=007coffee.shop
